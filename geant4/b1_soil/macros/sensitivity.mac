# ============================================================================
# sensitivity.mac - МАТРИЦА ЧУВСТВИТЕЛЬНОСТИ A (строго поочерёдное размещение)
# ============================================================================
# Для каждой позиции детектора i (сфера R=15 см на высоте 1 м над ячейкой)
# и каждой ячейки источника j (в грунте на глубине 10 см) выполняется
# отдельный прогон /run/beamOn. Отклик i-го детектора на единичную
# активность в ячейке j даёт элемент A[i][j] (обработка: python/build_sensitivity.py).
#
# Внимание: 25x25 = 625 прогонов. Для быстрого расчёта используйте
# sensitivity_fast.mac (все детекторы одновременно, 25 прогонов).
# ============================================================================
/control/alias b1soilN 2000000

# --- геометрия и физика ---
/b1soil/setGridNx 5
/b1soil/setGridNy 5
/b1soil/setCellSize 2 m
/b1soil/setSrcDepth 10 cm
/b1soil/setSoilDepth 2 m
/b1soil/setDetHeight 1 m
/b1soil/setDetRadius 15 cm
/b1soil/setSoilDensity 1.6 g/cm3
/b1soil/setGammaLine Cs137

# --- режим строго поочерёдного размещения детектора ---
/b1soil/setDetMode single

# --- вывод ---
/b1soil/setRunType SENSITIVITY
/b1soil/setOutputFile results_sensitivity.csv

/run/setCut 1 mm
/run/initialize
/run/numberOfThreads 4

# --- внешний цикл по позициям детектора, внутренний - по ячейкам источника ---
/control/loop sensitivity_det.mac detIdx 0 24 1
