# ============================================================================
# vis.mac - визуализация геометрии (интерактивный режим: запуск ./b1soil
# без аргументов). Геометрия: грунт + сетка детекторов на высоте 1 м.
# ============================================================================
/run/initialize

/vis/open OGL 600x600-0+0
/vis/drawVolume worlds
/vis/viewer/set/viewpointThetaPhi 65 30 deg
/vis/viewer/zoom 1.5
/vis/ogl/set/lineSegmentsPerCircle 100
/vis/viewer/set/autoRefresh true

# подсказка: чтобы показать траектории источника из ячейки 12 (центр),
# выполните затем:
#   /b1soil/setSrcIndex 12
#   /run/beamOn 10
