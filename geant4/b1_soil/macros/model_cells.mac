# Ячейки модельного источника (генерируется python/make_model_macro.py
# из model.json; ниже - пример по умолчанию: 3 горячих пятна).
# Координаты - центры ячеек сетки 5x5 с шагом 2 м, глубина 10 см.
/b1soil/addModelCell -2 -2 -0.1 m 1.0e8 Bq   # ячейка (1,1)
/b1soil/addModelCell  0  0 -0.1 m 2.0e8 Bq   # ячейка (2,2) - центр площадки
/b1soil/addModelCell  2  0 -0.1 m 5.0e7 Bq   # ячейка (3,2)
